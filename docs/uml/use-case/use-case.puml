@startuml
left to right direction

actor "Guest" as Guest
actor "Authenticated User" as AuthUser

rectangle "EPlinguaCards System" {
  usecase "Register" as UC_Register
  usecase "Login" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "Manage Decks\n(Create/Read/Update/Delete)" as UC_ManageDecks
  usecase "Manage Cards\n(Create/Read/Update/Delete)" as UC_ManageCards
  usecase "Start Training Session" as UC_StartTraining
  usecase "Rate Card\n(Again/Hard/Good/Easy)" as UC_RateCard
  usecase "View Statistics" as UC_ViewStats
}

Guest --> UC_Register
Guest --> UC_Login

AuthUser --> UC_Logout
AuthUser --> UC_ManageDecks
AuthUser --> UC_ManageCards
AuthUser --> UC_StartTraining
AuthUser --> UC_RateCard
AuthUser --> UC_ViewStats

@enduml
