### Login -> save token to global storage
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "jwtuser@example.com",
  "password": "password123"
}

> {%
    const data = JSON.parse(response.body);
    client.global.set("token", data.accessToken);
    client.log("Token saved: " + data.accessToken.substring(0, 15) + "...");
%}

### Me (uses token in pre-request script)
GET http://localhost:8080/api/me
< {%
  const token = client.global.get("token");
  if (!token) {
    throw new Error("No token saved. Run login request first.");
  }
  request.headers["Authorization"] = "Bearer " + token;
%}